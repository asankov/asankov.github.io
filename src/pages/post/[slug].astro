---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import { getPosts, formatDate, readTime } from '../../lib/posts';

export const getStaticPaths = (async () => {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Anton Sankov's Blog`} description={post.data.description}
  type="article" publishedDate={post.data.date}>
  <main id="main-content" class="max-w-4xl mx-auto px-6 py-12">
    <article>
      <header class="mb-8">
        <a href="/" class="inline-flex items-center text-gray-600 hover:text-black transition-colors mb-8">
          <Icon name="arrow-left" class="w-4 h-4 mr-2" />Back to all posts
        </a>
        <h1 class="text-4xl font-bold text-black mb-4">{post.data.title}</h1>
        <div class="flex items-center text-gray-500 gap-4">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span aria-hidden="true">•</span><span>{readTime(post.body)}</span>
        </div>
      </header>
      <div class="border-t border-gray-100 pt-12 prose"><Content /></div>
      <footer class="border-t border-gray-100 mt-16 pt-8">
        <a href="/" class="inline-flex items-center text-black hover:text-gray-600 transition-colors font-medium">
          <Icon name="arrow-left" class="w-4 h-4 mr-2" />Back to all posts
        </a>
      </footer>
    </article>
    <CodeCopy />
  </main>
</BaseLayout>
