---
import Header from '../components/Header.astro';
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  noindex?: boolean;
}

const {
  title = "Anton Sankov's Blog",
  description = 'Thoughts on AI and Software Engineering. Insights, lessons learned, and technical deep-dives by Anton Sankov.',
  type = 'website', publishedDate, noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/preview.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Anton Sankov" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:site_name" content="Anton Sankov's Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class="min-h-screen bg-white">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <slot />
  </body>
</html>
